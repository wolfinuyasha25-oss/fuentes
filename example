<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Blog | Solo Leveling Style</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    color: #eee;
    background:
        radial-gradient(circle at top, #172554, #050816 55%, #02030a);
}

/* HEADER */
header {
    min-height: 280px;
    padding: 70px 20px 40px;
    text-align: center;
    background:
        linear-gradient(rgba(3,8,25,.7), rgba(3,8,25,.95)),
        radial-gradient(circle, #2563eb, #020617);
    border-bottom: 3px solid #38bdf8;
    box-shadow: 0 0 35px #0284c7;
}

header h1 {
    font-size: clamp(35px, 6vw, 65px);
    color: #7dd3fc;
    text-shadow: 0 0 15px #0ea5e9, 0 0 35px #2563eb;
    letter-spacing: 3px;
}

header p {
    margin-top: 10px;
    color: #cbd5e1;
}

/* NAVBAR */
.navbar {
    width: 100%;
    min-height: 70px;
    padding: 15px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(2, 6, 23, .95);
    border-bottom: 1px solid #0ea5e9;
    box-shadow: 0 0 20px #0284c7;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar h3 {
    color: #38bdf8;
    text-shadow: 0 0 10px #0ea5e9;
}

.navbar ul {
    display: flex;
    gap: 25px;
    list-style: none;
}

.navbar a {
    color: #e0f2fe;
    text-decoration: none;
    font-weight: bold;
    transition: .3s;
}

.navbar a:hover {
    color: #38bdf8;
    text-shadow: 0 0 10px #38bdf8;
}

/* MAIN SECTIONS */
section, article {
    width: 100%;
}

.box {
    width: 94%;
    margin: 30px auto;
    padding: 35px;
    background: rgba(15, 23, 42, .92);
    border: 1px solid #0284c7;
    border-radius: 15px;
    box-shadow: 0 0 20px rgba(14,165,233,.25);
}

h2 {
    text-align: center;
    color: #7dd3fc;
    margin-bottom: 25px;
    text-shadow: 0 0 10px #0284c7;
}

h3 {
    color: #38bdf8;
}

/* INTRODUCTION */
.intro-box {
    background: linear-gradient(135deg, #0f172a, #082f49);
}

.intro-box p {
    margin: 15px 0;
    color: #dbeafe;
}

/* HOBBIES */
.hobby-box {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.hobby {
    flex: 1;
    min-width: 200px;
    padding: 25px;
    text-align: center;
    background: linear-gradient(145deg, #172554, #0c4a6e);
    border: 1px solid #38bdf8;
    border-radius: 12px;
    box-shadow: 0 0 15px rgba(14,165,233,.3);
}

ol, .hobby-box ul {
    display: inline-block;
    text-align: left;
    margin-top: 10px;
}

/* GALLERY */
.gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

figure {
    width: 280px;
    padding: 12px;
    background: #0f172a;
    border: 1px solid #0ea5e9;
    border-radius: 12px;
    transition: .3s;
}

figure:hover {
    transform: translateY(-8px);
    box-shadow: 0 0 25px #0284c7;
}

figure img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border-radius: 8px;
}

figcaption {
    padding: 10px;
    color: #7dd3fc;
}

/* TABLE */
.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: #0f172a;
}

th {
    background: #0369a1;
    color: white;
}

th, td {
    padding: 15px;
    border: 1px solid #0ea5e9;
    text-align: center;
}

tr:hover {
    background: #172554;
}

/* FLEXBOX CARDS */
.cards {
    display: flex;
    gap: 20px;
}

.card {
    flex: 1;
    padding: 25px;
    text-align: center;
    background: #172554;
    border: 1px solid #38bdf8;
    border-radius: 10px;
}

/* GRID */
.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.product {
    padding: 25px;
    text-align: center;
    background: #172554;
    border: 1px solid #2563eb;
    border-radius: 10px;
}

.calendar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
}

.day {
    padding: 15px 5px;
    text-align: center;
    background: #0c4a6e;
    border-radius: 5px;
}

.day.header {
    background: #0369a1;
    font-weight: bold;
}

/* FORM */
form {
    max-width: 800px;
    margin: auto;
}

input, textarea, select {
    width: 100%;
    padding: 12px;
    margin: 7px 0 15px;
    background: #020617;
    color: white;
    border: 1px solid #0ea5e9;
    border-radius: 6px;
}

input[type="checkbox"],
input[type="radio"] {
    width: auto;
}

input[type="file"] {
    background: #0f172a;
}

input[type="submit"] {
    width: auto;
    padding: 12px 30px;
    background: #0284c7;
    border: none;
    color: white;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 0 15px #0284c7;
}

input[type="submit"]:hover {
    background: #38bdf8;
    color: #020617;
}

/* CENTER BOX */
.center-container {
    min-height: 220px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #020617;
    border-radius: 10px;
}

.center-box {
    padding: 30px;
    color: white;
    background: #0369a1;
    border: 2px solid #7dd3fc;
    border-radius: 10px;
    box-shadow: 0 0 25px #0284c7;
}

/* FOOTER */
footer {
    padding: 30px;
    text-align: center;
    background: #020617;
    border-top: 2px solid #0284c7;
}

footer a {
    color: #38bdf8;
}

/* MOBILE */
@media(max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 12px;
    }

    .navbar ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 15px;
    }

    .box {
        width: 96%;
        padding: 22px;
    }

    .cards {
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .calendar {
        font-size: 12px;
    }
}

@media(max-width: 480px) {

    body {
        font-size: 15px;
    }

    .product-grid {
        grid-template-columns: 1fr;
    }

    .calendar {
        grid-template-columns: repeat(7, 1fr);
    }

    .day {
        padding: 10px 2px;
    }

    figure {
        width: 100%;
    }
}
</style>
</head>

